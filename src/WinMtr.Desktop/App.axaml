<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:WinMtr.Desktop.Services"
             x:Class="WinMtr.Desktop.App"
             RequestedThemeVariant="Default"
             >
  <!-- Stock Fluent stays: FluentAvalonia AppWindow/Theme breaks headless tests
  (Win32WindowManager HWND collision + Symbols font), so the beautiful-Fluent
  path here is custom ColorPaletteResources + Mica backdrop on plain Window.
  Default follows the OS light/dark preference; Settings can pin Light or
  Dark for this run (in-memory only, resets on restart).
  The data grid package ships its own Fluent theme part, without which the
  grid has no template and renders nothing. -->
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <!-- Neither palette sets Accent. Fluent reads the accent from the
           operating system. On Windows this is the system accent. On macOS
           this is the control accent. Where the desktop reports no accent,
           Fluent uses its own default blue. The shell, the selected hop row
           and the hop badge all use that one colour. The Mica backdrop uses
           the same colour. The accent can be any colour. So the text on the
           selected row cannot be fixed. AccentRowTextTheme computes it. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" RegionColor="#FFFFFF" ErrorText="#C42B1C" />
        <ColorPaletteResources x:Key="Dark" RegionColor="#202020" ErrorText="#FF99A4" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- Typography: the shell reads as one regular-weight surface. Fluent
         gives several parts a semibold default, which made the whole toolbar
         look emphasised; these selectors put every text-bearing part back to
         Normal so emphasis stays available where it means something. -->
    <!-- Keep the existing stack on Windows/Linux. The macOS pack replaces
         this semantic resource with the system UI face. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource WinMtrShellFontFamily}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="services:WindowIconTheme.IsEnabled" Value="True" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="SplitButton">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- The copy and export menus are part of the shell, not a bare popup:
         the presenter takes the same surface, border and corner radius as the
         detail pane and the confirmation popups. -->
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource WinMtrDetailBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WinMtrDetailBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource WinMtrSurfaceCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource WinMtrMenuPadding}" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <!-- Extracted presentation values retain their previous values on
           Windows and Linux. Only the macOS pack replaces them. -->
      <FontFamily x:Key="WinMtrShellFontFamily">Segoe UI Variable Text, Segoe UI, Inter, $Default</FontFamily>
      <FontFamily x:Key="WinMtrAddressFontFamily">Consolas, Menlo, monospace</FontFamily>
      <x:Double x:Key="WinMtrMainWindowMinWidth">560</x:Double>
      <x:Double x:Key="WinMtrSortGlyphFontSize">9</x:Double>
      <x:Double x:Key="WinMtrTargetMaxWidth">320</x:Double>
      <x:Double x:Key="WinMtrTargetMinWidth">180</x:Double>
      <x:Double x:Key="WinMtrStartStopMinWidth">80</x:Double>
      <Thickness x:Key="WinMtrToolbarLabelMargin">8,4</Thickness>
      <Thickness x:Key="WinMtrToolbarActionMargin">4</Thickness>
      <Thickness x:Key="WinMtrToolbarCopyMargin">12,4,4,4</Thickness>
      <x:Boolean x:Key="WinMtrToolbarCanWrap">True</x:Boolean>
      <x:Boolean x:Key="WinMtrHostMultilineVisible">True</x:Boolean>
      <x:Boolean x:Key="WinMtrHostLabelVisible">False</x:Boolean>
      <x:Boolean x:Key="WinMtrDetailWordsVisible">True</x:Boolean>
      <x:Boolean x:Key="WinMtrDetailDisclosureVisible">False</x:Boolean>
      <x:Int32 x:Key="WinMtrDetailToggleColumn">1</x:Int32>
      <CornerRadius x:Key="WinMtrSurfaceCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="WinMtrTileCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="WinMtrBannerCornerRadius">4</CornerRadius>
      <Thickness x:Key="WinMtrPopupPadding">12,8</Thickness>
      <Thickness x:Key="WinMtrMenuPadding">4</Thickness>
      <Thickness x:Key="WinMtrDetailPadding">12,10</Thickness>
      <Thickness x:Key="WinMtrTilePadding">12,8</Thickness>
      <Thickness x:Key="WinMtrBannerPadding">8,4</Thickness>
      <Thickness x:Key="WinMtrStatusPadding">8,4</Thickness>
      <Thickness x:Key="WinMtrHistoryItemPadding">8,6</Thickness>
      <Thickness x:Key="WinMtrSettingsMargin">16</Thickness>
      <Thickness x:Key="WinMtrSettingsButtonBarMargin">16,0,16,16</Thickness>
      <x:Double x:Key="WinMtrSettingsSpacing">8</x:Double>
      <!-- Semantic shell palette. Views read these keys through DynamicResource
           only. The approved light and dark design stays changeable in one place.
           The muted text of the retained hop row stays here too. The
           identity-change highlight stays here too. Both change with the light
           and dark preference of the operating system. The selected hop row
           fill has no colour of its own. Each theme sets the four selection
           keys to the system accent. The accent comes from the operating
           system, not from the palette. -->
      <!-- Selection fill for the route grid. The stock data grid theme fills
           the selected hop row with a grey list fill at part opacity. The four
           brush keys in each theme below use the accent instead. The four
           opacities below set that fill to full opacity. A fill at part opacity
           mixes with the Mica backdrop. The backdrop shows the system accent
           through the window. A tint then matches neither accent. The four
           states use one look. A row filled with the accent needs no hover
           change. It needs no focus change. Each such change would need its
           own text colour to keep contrast. -->
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1.0</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1.0</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1.0</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1.0</x:Double>
      <!-- Text on the accent-filled selected row. The fill is the accent of
           the operating system. The user can set that accent to any colour.
           So these two brushes have one owner. AccentRowTextTheme reads the
           accent that Fluent resolved. It writes white or near-black with a
           muted opacity. It measures the paint over the fill. It keeps the
           most muted step that holds 4.5. Where no step holds 4.5, it uses
           full strength. The brushes are outside the theme dictionaries. One
           accent is used for both theme variants. The values below are the
           start-up defaults. They match the Fluent default blue. A headless
           host that never starts the service still renders. The retained hop
           row text stays as muted as 4.5 allows. It stays readable. -->
      <SolidColorBrush x:Key="WinMtrRowSelectedTextBrush">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="WinMtrRowSelectedFrozenTextBrush" Color="#FFFFFF" Opacity="0.7" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <SolidColorBrush x:Key="WinMtrWindowBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrWindowFallbackBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrSubtleTextBrush">#616161</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrDetailBorderBrush">#D0D0D0</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrDetailBackgroundBrush">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrDetailTileBackgroundBrush">#F0F0F0</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrStatusBackgroundBrush">#F3F3F3</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrErrorTextBrush">#C42B1C</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrFrozenTextBrush">#616161</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrIdentityChangeBackgroundBrush">#D9EAFB</SolidColorBrush>
          <!-- Severity encoding in the route grid. The Loss ramp follows
               the loss grade. A latency outlier cell takes its own tint.
               The bar shows the loss fraction, so the level stays clear in
               monochrome. A frozen or selected row drops the tint, so the
               muted or accent text never sits on a ramp. -->
          <SolidColorBrush x:Key="WinMtrLossLowBackgroundBrush" Color="#C42B1C" Opacity="0.05" />
          <SolidColorBrush x:Key="WinMtrLossModerateBackgroundBrush" Color="#C42B1C" Opacity="0.09" />
          <SolidColorBrush x:Key="WinMtrLossHighBackgroundBrush" Color="#C42B1C" Opacity="0.13" />
          <SolidColorBrush x:Key="WinMtrLossTotalBackgroundBrush" Color="#C42B1C" Opacity="0.17" />
          <SolidColorBrush x:Key="WinMtrLossLowBarBrush">#EBC3BE</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossModerateBarBrush">#E4A099</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossHighBarBrush">#D66E67</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossTotalBarBrush">#C42B1C</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossBarTrackBrush" Color="#616161" Opacity="0.15" />
          <SolidColorBrush x:Key="WinMtrLatencyOutlierBackgroundBrush" Color="#C42B1C" Opacity="0.10" />
          <SolidColorBrush x:Key="WinMtrBannerInfoBackgroundBrush">#E5F1FB</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerInfoBorderBrush">#0078D4</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerWarningBackgroundBrush">#FFF4CE</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerWarningBorderBrush">#9D5D00</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerErrorBackgroundBrush">#FDE7E9</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerErrorBorderBrush">#C42B1C</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="SystemControlHighlightAccentBrush" />
          <SolidColorBrush x:Key="WinMtrWindowBackgroundBrush">#202020</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrWindowFallbackBrush">#202020</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrSubtleTextBrush">#A8A8A8</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrDetailBorderBrush">#3A3A3A</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrDetailBackgroundBrush">#1B1B1B</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrDetailTileBackgroundBrush">#262626</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrStatusBackgroundBrush">#202020</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrErrorTextBrush">#FF99A4</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerInfoBackgroundBrush">#0F2A40</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerInfoBorderBrush">#4CC2FF</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerWarningBackgroundBrush">#433519</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerWarningBorderBrush">#FCE100</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerErrorBackgroundBrush">#442726</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrBannerErrorBorderBrush">#FF99A4</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrFrozenTextBrush">#A8A8A8</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrIdentityChangeBackgroundBrush">#14324A</SolidColorBrush>
          <!-- Severity encoding in the route grid. The dark ramp uses a deep
               red base. The bar colours rise with the grade, so the line
               stays clear on the dark surface. A frozen or selected row
               drops the tint, so the muted or accent text never sits on a
               ramp. -->
          <SolidColorBrush x:Key="WinMtrLossLowBackgroundBrush" Color="#7A1F24" Opacity="0.25" />
          <SolidColorBrush x:Key="WinMtrLossModerateBackgroundBrush" Color="#7A1F24" Opacity="0.40" />
          <SolidColorBrush x:Key="WinMtrLossHighBackgroundBrush" Color="#7A1F24" Opacity="0.55" />
          <SolidColorBrush x:Key="WinMtrLossTotalBackgroundBrush" Color="#7A1F24" Opacity="0.70" />
          <SolidColorBrush x:Key="WinMtrLossLowBarBrush">#B76068</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossModerateBarBrush">#D37780</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossHighBarBrush">#E88792</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossTotalBarBrush">#FF99A4</SolidColorBrush>
          <SolidColorBrush x:Key="WinMtrLossBarTrackBrush" Color="#A8A8A8" Opacity="0.15" />
          <SolidColorBrush x:Key="WinMtrLatencyOutlierBackgroundBrush" Color="#7A1F24" Opacity="0.35" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
