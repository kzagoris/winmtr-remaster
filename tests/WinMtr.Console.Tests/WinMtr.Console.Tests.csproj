<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3 test projects are executables that run themselves. -->
    <OutputType>Exe</OutputType>
    <!-- Stay on VSTest like every other test project here:
         Microsoft.NET.Test.Sdk + xunit.runner.visualstudio, and the
         VSTestTestCaseFilter default in Directory.Build.props. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- xUnit1051 does not apply: tests own their CancellationTokens
         deterministically (FakeTimeProvider, explicit CTS for cancellation
         tests). TestContext.Current.CancellationToken would conflate runner
         cancellation with simulated trace cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinMtr.Console\WinMtr.Console.csproj" />
    <ProjectReference Include="..\WinMtr.TestSupport\WinMtr.TestSupport.csproj" />
  </ItemGroup>

</Project>
